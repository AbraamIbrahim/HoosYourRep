# Browser-visible Supabase settings; embedded during the Vite build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# External data and analysis APIs.
CONGRESS_API_KEY=
GEMINI_API_KEY=
